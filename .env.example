# Copy to `.env`. CLI flags override env. Unset keys keep code/dictionary defaults.
# Process env vars are also loaded by kutha-runtime via apply_dotenv (repo-root `.env`).

# Harness (kutha-gov)
KUTHA_GOV_BUDGET=76
KUTHA_GOV_FAIL_ON_WARN=0
# KUTHA_GOV_CARGO_TIMEOUT_SEC=180  # if set, overrides fsm observe_* timeout_sec (rocks wants 420)
KUTHA_TENANT_TIMEOUT_SEC=180
KUTHA_HARNESS_LOG=.kutha/events.jsonl
KUTHA_TENANT_DIR=.kutha/tenant
# KUTHA_TENANT_BIN=  # unset = $CARGO_TARGET_DIR/debug/kutha-tenant (or ./target/debug/kutha-tenant)
# KUTHA_HARNESS_RELATIONS_PATH=  # unset = .kutha/dictionaries/relations.yaml

# System RocksDB for optional rocks-index (librocksdb-sys links instead of building).
# ROCKSDB_LIB_DIR=/usr/lib/x86_64-linux-gnu
# ROCKSDB_INCLUDE_DIR=/usr/include
# Prefer unset CARGO_TARGET_DIR so cargo uses ./target (Cursor sandbox may redirect it).

# Product runtime
KUTHA_MAX_CASCADE=32
# KUTHA_RELATIONS_PATH=  # unset = crates/kutha-runtime/dictionaries/relations.yaml
#
# Fold secondary index leases (ADR-040 / M013 S03 D-06). Default Eager accepts write-cost.
#   eager | unset | other → warm maps on every fact push (visit-oracle friendly)
#   lazy  | thin          → thin write; scan until ensure_fold_indexes / indexed op
# Bench: cargo bench -p kutha-runtime --bench baseline  (prints fold_index_mode)
# Docs: docs/architecture/benchmark-baseline.md § FoldIndexMode
KUTHA_FOLD_INDEX_MODE=eager
